# Copia este archivo como .env.local para desarrollo local.
# En Vercel, estas variables se configuran en Project Settings -> Environment Variables.

# --- MODO DEMO (lo que corre en la demo publica) ---
# true = sin login, datos ficticios en el navegador, no se conecta a ningun Sheet.
DEMO_MODE=true

# --- MODO REAL (opcional, solo si DEMO_MODE no es "true") ---

# URL completa de tu Apps Script Web App (termina en /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_ID_AQUI/exec

# El token que ya usas para autenticarte contra el Apps Script
APPS_SCRIPT_TOKEN=tu_token_aqui

# La contraseña para entrar al dashboard (la inventas tu, cualquier string)
DASHBOARD_PASSWORD=elige_una_contraseña_segura

# Una clave aleatoria larga, solo para firmar la cookie de sesion.
# Generala una vez con: openssl rand -base64 32
SESSION_SECRET=genera_una_clave_aleatoria_larga
