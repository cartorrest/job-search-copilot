# Copy to .env.local for local development.
# On Vercel, set these in Project Settings -> Environment Variables.

# --- DEMO MODE (what the public demo runs) ---
# true = no login, fictional data in the browser, never touches a Sheet.
DEMO_MODE=true

# --- PRIVATE MODE (optional; only when DEMO_MODE is not "true") ---

# Full URL of the v1 Apps Script web app (ends in /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# The token stored as TRACKER_TOKEN in that script's properties
APPS_SCRIPT_TOKEN=your_token_here

# Dashboard password (anything you choose)
DASHBOARD_PASSWORD=choose_a_strong_password

# Random string (16+ characters) used to sign the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=generate_a_long_random_string
